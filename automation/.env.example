# Automation env template — NAMES ONLY, no real secrets. Copy to `.env` (gitignored).
# See docs/ENVIRONMENT_GUIDE.md. NEVER put production secrets or real broker creds here.

# Target selection: local | qa | prod  (auto-detected from QA_BASE_URL if unset)
QA_ENV=local
QA_BASE_URL=http://localhost:8000
QA_FRONTEND_URL=http://localhost:3000

# Broker mode: fake (default non-prod) | paper (manual suite only) | none (prod)
BROKER_MODE=fake

# QA-only JWT secret used to mint test tokens for authZ tests (must match the QA backend).
JWT_SECRET=__QA_ONLY_CHANGE_ME__

# Admin API access for seeding fake subscribers (QA-only admin account).
QA_ADMIN_EMAIL=qa-admin@kopyya.test
QA_ADMIN_PASSWORD=__QA_ONLY__

# Manual Alpaca Paper contract suite (disabled by default). DevOps-owned creds.
PAPER_SUITE_AUTHORIZED=false
