# LOCAL QA backend env — NAMES + local-only values. Copy to qa.env (gitignored) via `npm run local:up`
# (which generates fresh QA-only secrets). NEVER put production credentials here.
DATABASE_URL=postgresql+psycopg://qa:qa@db:5432/copytrading_qa
REDIS_URL=redis://:qaredispass@redis:6379/0

# QA-only secrets — generated per environment; must NOT be production values.
JWT_SECRET=__GENERATED_QA_ONLY__
CREDENTIAL_ENCRYPTION_KEY=__GENERATED_QA_FERNET_KEY__

CORS_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# External services DISABLED → log/sink mode (no real email/SMS, no broker aggregator).
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

LOG_LEVEL=INFO
