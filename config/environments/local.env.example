# Local QA stack — env template (NAMES ONLY, no real secrets).
# Copy to `local.env` (gitignored) and fill with QA-only values. NEVER use prod secrets or real broker creds.
QA_BASE_URL=http://localhost:8000
QA_FRONTEND_URL=http://localhost:3000
BROKER_MODE=fake
DATABASE_URL=postgresql+psycopg://qa:qa@localhost:5432/copytrading_qa
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=__QA_ONLY_CHANGE_ME__
CREDENTIAL_ENCRYPTION_KEY=__QA_ONLY_FERNET_KEY__
QA_ADMIN_EMAIL=qa-admin@kopyya.test
QA_ADMIN_PASSWORD=__QA_ONLY__
# Fake broker behavior (optional tuning for latency/perf tests)
MOCK_BROKER_PROFILE=flat
MOCK_BROKER_LATENCY_MS=300
